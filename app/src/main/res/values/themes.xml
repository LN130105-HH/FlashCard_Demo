<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.StudyWithFlashCard" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary_ice_cyan</item>
        <item name="colorPrimaryVariant">@color/primary_lagoon</item>
        <item name="colorOnPrimary">@color/surface_night</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondary_electric_sky</item>
        <item name="colorSecondaryVariant">@color/secondary_deep_blue</item>
        <item name="colorOnSecondary">@color/surface_night</item>

        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/surface_canvas</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/neutral_pale_slate</item>

        <!-- Status bar and Navigation bar -->
        <item name="android:statusBarColor">@color/surface_canvas</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/surface_canvas</item>

        <!-- Default text color -->
        <item name="android:textColor">@color/neutral_pale_slate</item>
        <item name="android:textColorPrimary">@color/neutral_pale_slate</item>
        <item name="android:textColorSecondary">@color/neutral_soft_slate</item>
        <item name="android:textColorHint">@color/neutral_muted</item>
    </style>

    <!-- Component Styles -->
    <style name="Widget.Crammr.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:backgroundTint">@color/primary_ice_cyan</item>
        <item name="android:textColor">@color/surface_night</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="android:textAllCaps">false</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Crammr.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:textColor">@color/primary_ice_cyan</item>
        <item name="strokeColor">@color/primary_deep_teal</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Crammr.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.Crammr.Card.Elevated" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface_elevated</item>
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="Widget.Crammr.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="boxBackgroundColor">@color/surface_card</item>
        <item name="boxStrokeColor">@color/neutral_slate_grey</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/primary_ice_cyan</item>
        <item name="android:textColorHint">@color/neutral_muted</item>
    </style>
</resources>
