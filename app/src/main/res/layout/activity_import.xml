<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_canvas"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarImport"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface_dark"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/import_data"
        app:titleTextColor="@color/neutral_pale_slate" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Import Flashcards"
                android:textColor="@color/neutral_pale_slate"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Select a CSV or JSON file containing flashcard data"
                android:textColor="@color/neutral_muted"
                android:textSize="13sp" />

            <!-- File Upload / Select Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/surface_elevated"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_circle_badge"
                        android:padding="12dp"
                        android:src="@drawable/ic_upload"
                        app:tint="@color/primary_ice_cyan" />

                    <TextView
                        android:id="@+id/tvImportSelectedFileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="No file selected yet"
                        android:textColor="@color/neutral_pale_slate"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvImportStatusHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Supported formats: .csv, .json"
                        android:textColor="@color/neutral_muted"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectImportFile"
                        style="@style/Widget.Crammr.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="16dp"
                        android:text="@string/choose_file" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Target Collection Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="6dp"
                android:text="Target Collection Name"
                android:textColor="@color/neutral_soft_slate"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Crammr.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etImportCollectionName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Imported Collection"
                    android:textColor="@color/neutral_pale_slate"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Import Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmImport"
                style="@style/Widget.Crammr.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="28dp"
                android:text="Import Flashcards" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
