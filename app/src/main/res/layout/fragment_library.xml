<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_canvas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/nav_library"
                android:textColor="@color/neutral_pale_slate"
                android:textSize="26sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnManageCategories"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_badge"
                android:padding="8dp"
                android:src="@drawable/ic_library"
                app:tint="@color/primary_ice_cyan" />
        </LinearLayout>

        <!-- Search Input Bar -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Crammr.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="20dp"
            android:hint="@string/search_collections"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/neutral_muted">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearchCollections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="@color/neutral_pale_slate"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Collections Recycler List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCollections"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="80dp" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layoutEmptyLibrary"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_circle_badge"
                android:padding="16dp"
                android:src="@drawable/ic_library"
                app:tint="@color/neutral_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/empty_collections_title"
                android:textColor="@color/neutral_pale_slate"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/empty_collections_desc"
                android:textColor="@color/neutral_muted"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreateFirstCollection"
                style="@style/Widget.Crammr.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="20dp"
                android:text="@string/new_collection" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddCollection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:backgroundTint="@color/primary_ice_cyan"
        android:text="@string/new_collection"
        android:textColor="@color/surface_night"
        android:textStyle="bold"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/surface_night" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
