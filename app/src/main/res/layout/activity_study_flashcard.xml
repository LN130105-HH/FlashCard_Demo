<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_canvas">

    <!-- Top Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarStudy"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface_dark"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Flashcard Study"
        app:titleTextColor="@color/neutral_pale_slate">

        <TextView
            android:id="@+id/tvStudyProgressCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="20dp"
            android:text="1 / 5"
            android:textColor="@color/primary_ice_cyan"
            android:textSize="14sp"
            android:textStyle="bold" />
    </androidx.appcompat.widget.Toolbar>

    <!-- Progress Indicator Bar -->
    <ProgressBar
        android:id="@+id/studyProgressBar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:max="100"
        android:progress="20"
        android:progressDrawable="@drawable/progress_indicator_crammr"
        app:layout_constraintTop_toBottomOf="@id/toolbarStudy" />

    <!-- Center Card Flip Area -->
    <FrameLayout
        android:id="@+id/cardFlipContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/layoutStudyActions"
        app:layout_constraintTop_toBottomOf="@id/studyProgressBar">

        <!-- FRONT VIEW (Question) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFrontView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/surface_elevated"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag_processing"
                    android:text="QUESTION"
                    android:textColor="@color/secondary_sky"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvQuestionFront"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="center"
                    android:lineSpacingExtra="6dp"
                    android:text="What is an Array and its primary access time complexity?"
                    android:textColor="@color/neutral_pale_slate"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_eye"
                        app:tint="@color/neutral_muted" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/tap_to_flip"
                        android:textColor="@color/neutral_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- BACK VIEW (Answer) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBackView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface_elevated"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/primary_lagoon"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag_ready"
                    android:text="ANSWER"
                    android:textColor="@color/primary_ice_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAnswerBack"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:lineSpacingExtra="6dp"
                    android:text="An Array is a contiguous memory structure storing items of the same type. Direct index access runs in O(1) time."
                    android:textColor="@color/primary_frost"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvExplanationBack"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="Direct pointer arithmetic enables instant element indexing."
                    android:textColor="@color/neutral_muted"
                    android:textSize="13sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap to see question again"
                    android:textColor="@color/neutral_deep_slate"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- Bottom Actions: Need Review & Remembered -->
    <LinearLayout
        android:id="@+id/layoutStudyActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNeedReview"
            style="@style/Widget.Crammr.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:strokeColor="@color/status_warning"
            android:text="@string/not_remembered"
            android:textColor="@color/status_warning" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRemembered"
            style="@style/Widget.Crammr.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/remembered" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
