<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardQuizOption"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/surface_elevated"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvOptionPrefix"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_circle_badge"
            android:gravity="center"
            android:text="A"
            android:textColor="@color/primary_ice_cyan"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOptionText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Option text here"
            android:textColor="@color/neutral_pale_slate"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/ivOptionStatus"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_checkmark"
            android:visibility="gone"
            app:tint="@color/status_success" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
