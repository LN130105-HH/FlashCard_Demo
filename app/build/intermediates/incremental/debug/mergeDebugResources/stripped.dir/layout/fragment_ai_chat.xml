<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_canvas">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/layoutAiHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle_badge"
            android:padding="8dp"
            android:src="@drawable/ic_chat"
            app:tint="@color/primary_ice_cyan" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_assistant_title"
                android:textColor="@color/neutral_pale_slate"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Online • Powered by Crammr AI"
                android:textColor="@color/status_success"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Suggestion Chips Container (Frame 3.1) -->
    <HorizontalScrollView
        android:id="@+id/scrollSuggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_canvas"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/layoutAiHeader">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipSuggest1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_tag_processing"
                android:text="@string/ai_suggest_1"
                android:textColor="@color/secondary_sky"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipSuggest2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_tag_ready"
                android:text="@string/ai_suggest_2"
                android:textColor="@color/primary_ice_cyan"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipSuggest3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_draft"
                android:text="@string/ai_suggest_3"
                android:textColor="@color/neutral_soft_slate"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Chat Messages List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/layoutAiInput"
        app:layout_constraintTop_toBottomOf="@id/scrollSuggestions" />

    <!-- AI Generating / Thinking indicator (Frame 3.2) -->
    <LinearLayout
        android:id="@+id/layoutAiThinking"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_flashcard_front"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layoutAiInput"
        app:layout_constraintStart_toStartOf="parent">

        <ProgressBar
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:indeterminateTint="@color/primary_ice_cyan" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="AI is thinking and drafting cards…"
            android:textColor="@color/neutral_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Bottom Chat Input Bar -->
    <LinearLayout
        android:id="@+id/layoutAiInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/btnAttachDocument"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_attach"
            app:tint="@color/neutral_soft_slate" />

        <EditText
            android:id="@+id/etChatMessage"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_segmented_container"
            android:hint="@string/ai_chat_hint"
            android:inputType="textCapSentences"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/neutral_pale_slate"
            android:textColorHint="@color/neutral_muted"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/btnSendMessage"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_primary"
            android:padding="10dp"
            android:src="@drawable/ic_send"
            app:tint="@color/surface_night" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
